# Purpose: server-only configuration. Copy to .env; never put secrets in frontend files.
APP_ENV=development
APP_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./data/arav.db
STORAGE_PATH=./data/documents
DEMO_MODE=true
SEED_DEMO=true
ADMIN_EMAIL=admin@arav.local
ADMIN_PASSWORD=ChangeMe-Demo-2026!
COOKIE_SECURE=false
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional semantic retrieval. Off uses local case-scoped keyword retrieval.
EMBEDDINGS_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
WORKER_ENABLED=true
MONITOR_INTERVAL_SECONDS=3600
MEDICAL_GAP_DAYS=14
INSURANCE_GAP_DAYS=10
MAX_UPLOAD_MB=20
# SMTP delivery is disabled in demo. Use a sandbox mailbox before real recipients.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Filevine requires your tenant's approved mapping; see docs/INTEGRATIONS.md.
FILEVINE_BASE_URL=https://api.filevineapp.com
FILEVINE_ACCESS_TOKEN=
FILEVINE_ORG_ID=
FILEVINE_USER_ID=
FILEVINE_PROJECT_TYPE_ID=
